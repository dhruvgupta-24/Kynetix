<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never copy app data off the device, either to cloud backup
     or in a device-to-device transfer. Prefs hold the signed-in session and
     every account's local meal/workout data; the source of truth for a user's
     data is their Kynetix account, which syncs on sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
