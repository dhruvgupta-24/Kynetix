<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is the 30 min floor Android allows. The provider also
     schedules an update at the next local midnight, and every render compares
     the payload's date with today, so yesterday's numbers are never shown. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    
    
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/kynetix_widget_2x2"
    android:previewImage="@drawable/kynetix_widget_preview"
    android:description="@string/kynetix_widget_description"
    android:resizeMode="none"
    android:widgetCategory="home_screen">
</appwidget-provider>
