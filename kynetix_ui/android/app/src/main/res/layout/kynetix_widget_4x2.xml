<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kynetix_widget_background"
    android:padding="8dp">

    <!-- Container for side-by-side rings and text -->
    <LinearLayout
        android:id="@+id/widget_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Column 1: Calories -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="4dp">

            <!-- Ring image -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_calories_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <!-- Small center value inside ring -->
                <TextView
                    android:id="@+id/widget_calories_center_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Text on the right of the ring -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CALORIES"
                    android:textColor="#FF6B35"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_calories_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- kcal left"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_calories_consumed_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / -- consumed"
                    android:textColor="#9CA3AF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="#2A2A3C"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Column 2: Protein -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp">

            <!-- Ring image -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_protein_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <!-- Small center value inside ring -->
                <TextView
                    android:id="@+id/widget_protein_center_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Text on the right of the ring -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTEIN"
                    android:textColor="#52B788"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_protein_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--g left"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_protein_consumed_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / -- consumed"
                    android:textColor="#9CA3AF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Fallback state overlay -->
    <TextView
        android:id="@+id/widget_fallback_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Open Kynetix to set targets"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:gravity="center"
        android:textStyle="italic"
        android:visibility="gone" />

</RelativeLayout>
