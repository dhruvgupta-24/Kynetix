<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="4dp">

    <!-- Container for rings and center text -->
    <RelativeLayout
        android:id="@+id/widget_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/widget_timestamp_layout"
        android:layout_alignParentTop="true"
        android:gravity="center">

        <!-- Enlarge the rings container to fill as much space as possible -->
        <FrameLayout
            android:id="@+id/widget_rings_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">

            <ImageView
                android:id="@+id/widget_progress_rings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <!-- Center overlay text -->
            <LinearLayout
                android:id="@+id/widget_center_text_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_calories_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_calories_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kcal left"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:layout_marginBottom="4dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_protein_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#52B788"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_protein_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="protein left"
                    android:textColor="#9CA3AF"
                    android:textSize="9sp"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>

    <!-- Fallback state overlay -->
    <TextView
        android:id="@+id/widget_fallback_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Open Kynetix to set targets"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:gravity="center"
        android:textStyle="italic"
        android:visibility="gone" />

    <!-- Last updated timestamp -->
    <LinearLayout
        android:id="@+id/widget_timestamp_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated --:--"
            android:textColor="#809CA3AF"
            android:textSize="9sp" />
    </LinearLayout>

</RelativeLayout>
