<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Health Connect permissions ─────────────────────────────────────── -->
    <!-- Exactly the types lib/services/health_service.dart requests (READ only).
         Keep this list and the Play Console health declaration in sync. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_WEIGHT"/>
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY"/>
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup=false: prefs hold the Supabase session and every
         account's cached data; they must not be restored onto another
         device or reinstall. usesCleartextTraffic=false: all traffic is
         HTTPS (the ChatGPT PKCE loopback is a server inside the app that the
         browser calls, which this setting does not affect). -->
    <!-- Barcode scanning for packaged food -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Rest-timer notifications (countdown while resting, "rest over" when
         the app is in the background). Asked for at the first rest timer on
         Android 13+; the workout never depends on it being granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exact "rest over" alarm while the app is backgrounded/frozen. Checked
         with canScheduleExactNotifications(); without it the alert is
         scheduled inexactly. (Not USE_EXACT_ALARM: that is reserved for
         alarm-clock / calendar apps.) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:label="Kynetix"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- OpenAI device auth callback — dedicated filter with explicit path -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="kynetix"
                    android:host="openai-auth"
                    android:path="/callback" />
            </intent-filter>

            <!-- Health Connect (Android 13 and lower): "privacy policy" link
                 on the permission screen. MainActivity opens the in-app
                 privacy policy. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Supabase Auth deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kynetix" android:host="reset-password" />
                <data android:scheme="kynetix" android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- ── Health Connect: privacy policy rationale link ──────────────── -->
        <!-- Android 14+. Required by Google Play when requesting Health Connect
             permissions; MainActivity opens the in-app privacy policy. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>

        <!-- Kynetix Home Widget -->
        <receiver
            android:name=".KynetixWidgetProvider"
            android:exported="true"
            android:label="@string/kynetix_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kynetix_widget_info" />
        </receiver>

        <receiver
            android:name=".KynetixWidgetWide"
            android:exported="true"
            android:label="@string/kynetix_widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kynetix_widget_wide_info" />
        </receiver>

        <receiver
            android:name=".KynetixWidgetTall"
            android:exported="true"
            android:label="@string/kynetix_widget_tall_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kynetix_widget_tall_info" />
        </receiver>

        <receiver
            android:name=".KynetixWidgetLarge"
            android:exported="true"
            android:label="@string/kynetix_widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kynetix_widget_large_info" />
        </receiver>

        <!-- flutter_local_notifications: delivers scheduled notifications
             (the rest timer's "Rest over" alert). -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- ── Package visibility ────────────────────────────────────────────── -->
    <queries>
        <!-- Health Connect app -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>

        <!-- Required to query activities that can process text (Flutter engine) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Required for url_launcher to open https:// URLs on Android 11+ -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
